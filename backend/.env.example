# SQLAlchemy database URL; prod appends ?sslmode=require for the managed cluster.
DATABASE_URL=postgresql+psycopg://supercpe:change-me@localhost:5432/supercpe
# Allowed browser origins; prod must be exactly https://supercpe.com.
CORS_ORIGINS=http://localhost:5173
# Where LocalStorage keeps objects (ignored under STORAGE_BACKEND=spaces).
STORAGE_ROOT=uploads
# True on a developer machine (session cookie without the Secure flag);
# production sets false.
DEV=true
# dev | prod. prod refuses to boot unless DEV=false, CORS is same-origin,
# DATABASE_URL carries sslmode=require, and STORAGE_BACKEND=spaces.
ENV=dev
# local | spaces. spaces requires all five SPACES_* values below.
STORAGE_BACKEND=local
# Spaces bucket name (private; nothing is ever served from it directly).
SPACES_BUCKET=
# Spaces region slug, e.g. nyc3.
SPACES_REGION=
# Spaces endpoint URL, e.g. https://nyc3.digitaloceanspaces.com.
SPACES_ENDPOINT=
# Spaces access key id.
SPACES_KEY=
# Spaces secret key (at least 32 bytes; prod refuses shorter).
SPACES_SECRET=
# Git sha baked into the image at build time; /api/v1/health reports it.
APP_VERSION=dev
# console | smtp (017). console logs the message and writes the outbound
# table — no network; smtp requires all five EMAIL_* values below and is
# what the coming_soon -> open flip demands. Provider choice is an ops
# step recorded in docs/OPERATIONS.md.
EMAIL_BACKEND=console
# SMTP host, e.g. smtp.example.com.
EMAIL_HOST=
# SMTP port for STARTTLS, usually 587; 0 means unset.
EMAIL_PORT=0
# SMTP credentials from the chosen provider.
EMAIL_USERNAME=
EMAIL_PASSWORD=
# The From address, e.g. "superCPE <no-reply@supercpe.com>"; must parse
# as an email address.
EMAIL_FROM=
# Stripe checkout (018). All three or none; absent entirely is valid
# while the site is coming-soon, and the coming_soon -> open flip
# refuses without them. Use the restricted key, not the full secret key
# (docs/OPERATIONS.md, "Payments (018)").
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
