# supercpe.com behind Caddy: automatic Let's Encrypt TLS, HSTS, static
# frontend, /api/* proxied to the API container, and a login rate limit
# (009's known gap). rate_limit is the mholt/caddy-ratelimit plugin,
# compiled in by deploy/Dockerfile.web.

{
	# rate_limit is a non-standard directive; give it a place in the
	# middleware order.
	order rate_limit before reverse_proxy
	email admin@supercpe.com
}

www.supercpe.com {
	redir https://supercpe.com{uri} permanent
}

supercpe.com {
	encode gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	handle /api/* {
		rate_limit {
			zone login {
				match {
					method POST
					path /api/v1/auth/login
				}
				key {client_ip}
				events 10
				window 1m
			}
			# 015: the waiting-list signup was the first other anonymous
			# POST; same shape as the login rule.
			zone waiting_list {
				match {
					method POST
					path /api/v1/waiting-list
				}
				key {client_ip}
				events 10
				window 1m
			}
			# 017: registration, verification, and resend — anonymous
			# POSTs once the site is open, same shape as the login rule.
			zone registration {
				match {
					method POST
					path /api/v1/register /api/v1/verify /api/v1/resend-verification
				}
				key {client_ip}
				events 10
				window 1m
			}
			# 019: the public certificate verification lookup — an
			# anonymous unauthenticated GET once the site is open, same
			# shape as the signup rule.
			zone certificate_verification {
				match {
					method GET
					path /api/v1/certificates/verify/*
				}
				key {client_ip}
				events 10
				window 1m
			}
		}
		reverse_proxy api:8000
	}

	# 022: /sitemap.xml is the API's mode-aware answer, not a static
	# file — rewritten under /api/v1 where the route actually lives.
	# robots.txt points crawlers here; no rate limit, same as any GET
	# the SPA serves.
	handle /sitemap.xml {
		rewrite * /api/v1/sitemap.xml
		reverse_proxy api:8000
	}

	# Everything else is the built SPA; client-side routes fall back to
	# index.html. /media/* is not special-cased: in prod the API never
	# mounts it, so it 404s like any unknown /api path would.
	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}
