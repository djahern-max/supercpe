# Template for /srv/supercpe/.env on the droplet — copy it there by hand,
# fill in the real values (they exist nowhere in this repo), and set
#     chown <deploy-user>: /srv/supercpe/.env && chmod 600 /srv/supercpe/.env
# The api container mounts it read-only.

# Managed Postgres connection string from the DigitalOcean control panel,
# rewritten to the SQLAlchemy driver and keeping sslmode=require.
DATABASE_URL=postgresql+psycopg://supercpe:REPLACE@REPLACE-host:25060/supercpe?sslmode=require

CORS_ORIGINS=https://supercpe.com
DEV=false
ENV=prod
STORAGE_BACKEND=spaces
SPACES_BUCKET=REPLACE
SPACES_REGION=nyc3
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_KEY=REPLACE
SPACES_SECRET=REPLACE

# APP_VERSION is baked into the image by deploy.sh; do not set it here.
