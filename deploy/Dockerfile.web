# The web image: the Vite frontend built to static files, served by Caddy
# with automatic TLS. Build context is the repo root.

FROM node:22-slim AS frontend
WORKDIR /src
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ .
# Empty API base: the built app calls /api/v1/* same-origin and Caddy
# proxies it, so no cross-origin request exists in production.
ENV VITE_API_URL=
RUN npm run build

# Caddy's rate-limit handler is a plugin, so the binary is built with
# xcaddy (the supported way to add Caddy plugins).
FROM caddy:2-builder AS caddy-build
RUN xcaddy build --with github.com/mholt/caddy-ratelimit

FROM caddy:2
COPY --from=caddy-build /usr/bin/caddy /usr/bin/caddy
COPY --from=frontend /src/dist /srv/www
COPY deploy/Caddyfile /etc/caddy/Caddyfile
