POSTGRES_USER=supercpe
POSTGRES_PASSWORD=change-me
POSTGRES_DB=supercpe
# Google sign-in (030). The OAuth Web application client id from the
# sponsor's Google Cloud project (docs/OPERATIONS.md, "Google sign-in
# (030)"). Optional and alone: unset means no Google button and the
# endpoint refuses; it is not part of the open gate. ID-token flow —
# there is no client secret and no redirect URI.
GOOGLE_CLIENT_ID=
